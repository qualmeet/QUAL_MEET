{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "strict": true,

    "baseUrl": ".",
    "paths": {
      "@shared/*": ["shared/*"]
    },

    "ignoreDeprecations": "5.0",

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  }
}
